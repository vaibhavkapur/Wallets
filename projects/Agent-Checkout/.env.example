PAYMENT_MODE=sandbox
ADDR=127.0.0.1:8088
APP_ORIGIN=http://127.0.0.1:5188
# Optional; otherwise uses the local single-process file store.
# DATABASE_URL=postgres://uno:uno_local@127.0.0.1:54328/uno?sslmode=disable
# Set a stable random SESSION_SECRET if sessions must survive server restarts.
OPERATOR_TOKEN=local-operator
WEBHOOK_SECRET=local-webhook-secret
SECURE_COOKIES=false
# A separate worker requires PostgreSQL.
WORKER_MODE=embedded
