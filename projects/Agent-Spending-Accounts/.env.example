# Copy to .env (docker compose) or export in your shell. Development values only.

# Control plane
DATABASE_URL=postgres://asa:asa@localhost:5432/asa?sslmode=disable
LISTEN_ADDR=:8080
INTERNAL_TOKEN=dev-internal-token           # shared with the gateway; CHANGE outside local use
OPERATOR_TOKEN=                              # empty = organization creation is open (development)
GRANT_SIGNING_SEED=                          # 32-byte Ed25519 seed (base64/hex); empty = ephemeral key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RUN_WORKERS=true
FACILITATOR_URL=http://127.0.0.1:9402        # settlement lookup; the mock resource provides it
SUBMITTED_GRACE=2m
UNKNOWN_RELEASE_AFTER=24h

# Gateway
CONTROL_PLANE_URL=http://127.0.0.1:8080
SIGNER_URL=http://127.0.0.1:9403
SIGNER_TOKEN=dev-signer-token
MAX_RESPONSE_BYTES=1048576
REQUEST_DEADLINE_SECONDS=30
ALLOW_HTTP=true                              # DEVELOPMENT ONLY: plain-http resources
ALLOW_PRIVATE_TARGETS=true                   # DEVELOPMENT ONLY: loopback/private destinations
RUST_LOG=info

# Fixtures
PAY_TO=0x209693Bc6afc0C5328bA36FaF03C514EF312287C
WALLET_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# TypeScript packages
ASA_CONTROL_PLANE_URL=http://127.0.0.1:8080
ASA_GATEWAY_URL=http://127.0.0.1:8402
ASA_RESOURCE_URL=http://127.0.0.1:9402
# ASA_AGENT_API_KEY=agent_...                 # MCP adapter / example agent
VITE_CONTROL_PLANE_URL=http://127.0.0.1:8080
