# Export in your shell for optimizerd/optimizerctl/offline-eval. Development values only.
# `make up` (scripts/dev-up.sh) needs none of these: devstack supplies its own.

# API (orchestrator/cmd/optimizerd)
DATABASE_URL=postgres://optimizer:optimizer@127.0.0.1:5432/optimizer?sslmode=disable
OPTIMIZER_LISTEN_ADDR=127.0.0.1:8080
OPTIMIZER_MODE=shadow                       # shadow (record only) or assisted (handoffs allowed)
OPTIMIZER_POLICY_FILE=config/policy.v1.json
OPTIMIZER_RECORDED_DIR=fixtures/recorded/v1 # recorded quote provider dataset
ENGINE_URL=http://127.0.0.1:8081
ENGINE_AUTH_TOKEN=dev-engine-token-0123456789abcdef   # shared with the engine; CHANGE outside local use
EXECUTOR_WEBHOOK_URL=                       # optional: outbox delivery target for execution handoffs
EXECUTOR_WEBHOOK_SECRET=                    # required with the URL; >= 24 bytes, HMAC-SHA256

# Engine (engine/crates/optimizer-service)
ENGINE_LISTEN_ADDR=127.0.0.1:8081
# ENGINE_AUTH_TOKEN as above

# Comparison UI dev proxy (web/apps/compare)
OPTIMIZER_API_URL=http://127.0.0.1:8080
OPTIMIZER_API_KEY=                          # defaults to .dev/api-key written by make up
