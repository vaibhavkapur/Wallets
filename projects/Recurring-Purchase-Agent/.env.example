ADDR=127.0.0.1:8090
DEMO_MODE=true
DATA_PATH=.local/recurring-state.json
# Set DATABASE_URL to use PostgreSQL instead of the local durable file store:
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/recurring_agent?sslmode=disable
ALLOWED_ORIGIN=http://127.0.0.1:5190
SESSION_SECRET=local-dev-recurring-secret
OPERATOR_TOKEN=local-operator
WEBHOOK_SECRET=local-webhook-secret
SECURE_COOKIES=false
RUN_EMBEDDED_WORKER=true
# Optional sibling service integrations:
# AGENT_CHECKOUT_URL=http://127.0.0.1:8088
# OPTIMIZER_URL=http://127.0.0.1:8089
