# Copy to .env and `set -a; source .env; set +a`, or export in your process manager.
# Never commit real keys. Live keys must only exist on the production host.

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mywallet?sslmode=disable
LISTEN_ADDR=:8080

# stripe (default) or fake (development fixture; refuses to start if STRIPE_SECRET_KEY is set)
PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Pin to the version the iOS SDK expects for ephemeral keys (see docs/getting-started.md).
# stripe-ios 26.12.1 uses 2020-08-27.
STRIPE_API_VERSION=2020-08-27

# Sign in with Apple audiences = the app bundle identifier(s).
APPLE_BUNDLE_IDS=com.mywallet.ios
# Development only: accept "dev:<subject>" identity tokens instead of Apple's.
# DEV_SIGN_IN=1

SESSION_TTL=720h
RUN_WORKER=true
